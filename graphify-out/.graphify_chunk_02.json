{
  "nodes": [
    {"id": "docs_roadmap_v6_docking_composite_ranking", "label": "V6 Docking & Composite Ranking", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\roadmap.md", "source_location": "Version 6", "rationale": "Turn generated candidates into ranked, actionable results. Sequenced after V5 so the diffusion core is proven; vision deliberately deferred to V9 so the highest-risk piece never gates a working product."},
    {"id": "docs_roadmap_v0_foundation", "label": "V0 Project Foundation", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\roadmap.md", "source_location": "Version 0"},
    {"id": "docs_roadmap_v1_knowledge_base", "label": "V1 Molecule Knowledge Base", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\roadmap.md", "source_location": "Version 1", "rationale": "Bulk PubChem/ChEMBL slice only - do not attempt full-database ingestion."},
    {"id": "docs_roadmap_v2_intake_retrieval", "label": "V2 Project Intake & Retrieval", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\roadmap.md", "source_location": "Version 2"},
    {"id": "docs_roadmap_v3_property_filtering", "label": "V3 Property Filtering Pipeline", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\roadmap.md", "source_location": "Version 3", "rationale": "Get filtering solid before adding generative complexity - cheap and immediately useful even without generation."},
    {"id": "docs_roadmap_v4_baseline_generation", "label": "V4 Baseline Generative Agent", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\roadmap.md", "source_location": "Version 4", "rationale": "Prove the generative core works before layering the novel retrieval-augmented mechanism on top."},
    {"id": "docs_roadmap_v5_retrieval_augmented_generation", "label": "V5 Retrieval-Augmented Generation", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\roadmap.md", "source_location": "Version 5", "rationale": "The technical core of the product - condition the diffusion model on retrieved known compounds."},
    {"id": "docs_roadmap_v7_multi_agent_orchestration", "label": "V7 Multi-Agent Orchestration via LangGraph", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\roadmap.md", "source_location": "Version 7", "rationale": "Wire the individually-working agents from V1-V6 into a real LangGraph workflow rather than separate endpoints called in sequence by the frontend."},
    {"id": "docs_roadmap_v8_report_agent", "label": "V8 Report Agent & Research Notebook", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\roadmap.md", "source_location": "Version 8"},
    {"id": "docs_roadmap_v9_vision_agent", "label": "V9 Vision Agent Structure Extraction", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\roadmap.md", "source_location": "Version 9", "rationale": "Deliberately last among core capability versions - the highest-risk piece should not gate a working product."},
    {"id": "docs_roadmap_v10_hardening", "label": "V10 Production Hardening & Safety", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\roadmap.md", "source_location": "Version 10"},
    {"id": "docs_roadmap_version_discipline", "label": "Build in Versions, De-Risk the Hard Part Last", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\CLAUDE.md", "source_location": "Guiding Principle", "rationale": "Prove the core retrieval -> generate -> filter -> dock -> report loop works end-to-end on already-structured data before touching the vision pipeline, so if vision turns out harder than expected the project still has something to show."},
    {"id": "docs_roadmap_never_cut", "label": "Things Never to Cut", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\CLAUDE.md", "source_location": "Guiding Principle", "rationale": "RDKit property filtering, docking against a real target, retrieval with real citations, transparent/disclosed scoring, the dual-use safety screening pass, and an honest README that never implies a generated molecule has been validated as a real drug candidate."},
    {"id": "docs_architecture_coordinator", "label": "Coordinator Agent", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Agents"},
    {"id": "docs_architecture_vision_agent", "label": "Vision Agent", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Agents", "rationale": "Slow - runs as a background job."},
    {"id": "docs_architecture_retrieval_agent", "label": "Retrieval Agent", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Agents"},
    {"id": "docs_architecture_generation_agent", "label": "Generation Agent", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Agents"},
    {"id": "docs_architecture_property_agent", "label": "Property Agent", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Agents"},
    {"id": "docs_architecture_docking_agent", "label": "Docking Agent", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Agents", "rationale": "Slow - background job. Docks surviving candidates and computes a composite rank score."},
    {"id": "docs_architecture_report_agent", "label": "Report Agent", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Agents"},
    {"id": "docs_architecture_memory_agent", "label": "Memory Agent", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Agents"},
    {"id": "docs_architecture_evaluation_agent", "label": "Evaluation Agent", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Agents"},
    {"id": "docs_architecture_safety_agent", "label": "Safety Agent", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Agents"},
    {"id": "docs_architecture_langgraph_workflow", "label": "LangGraph Core Stages Workflow", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "LangGraph Workflow - Core Stages", "rationale": "intake -> literature ingestion -> KB indexing -> retrieval -> conditioned generation -> safety screening -> property filtering -> docking & ranking -> report assembly -> memory write. The Coordinator can re-enter the graph partway through."},
    {"id": "docs_architecture_retmol_conditioning", "label": "RetMol-Style Retrieval-Augmented Diffusion", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Retrieval-Augmented Generation", "rationale": "The technical core and direct analogue of LLM-RAG applied to a diffusion model: retrieved molecule embeddings projected into the conditioning space and injected during denoising, either as cross-attention context or as a guidance vector."},
    {"id": "docs_architecture_weak_retrieval_fallback", "label": "Fallback on Weak Retrieval", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Retrieval-Augmented Generation", "rationale": "If no sufficiently similar known compounds exist, fall back to plain property-conditioned generation rather than forcing a conditioning signal from irrelevant molecules - and say so explicitly in the report."},
    {"id": "docs_architecture_vision_pipeline", "label": "Vision Pipeline Structure Extraction", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Vision Pipeline"},
    {"id": "docs_architecture_property_filtering", "label": "Property Filtering Gate", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Property Filtering", "rationale": "Docking is the most expensive step - filter hard before it. Each filter's pass/fail and raw value is stored and shown per candidate, never collapsed into a single opaque good/bad flag."},
    {"id": "docs_architecture_docking_composite_ranking", "label": "Docking & Composite Ranking", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Docking & Composite Ranking", "rationale": "The exact formula must be disclosed in the report and the UI, following the same transparency principle used for LexBook-AI's readiness estimates. Example starting formula: rank_score = 0.5 * normalized_docking_affinity + 0.3 * QED + 0.2 * novelty."},
    {"id": "docs_architecture_rank_score_formula", "label": "rank_score = 0.5*norm_affinity + 0.3*QED + 0.2*novelty", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Docking & Composite Ranking"},
    {"id": "docs_architecture_novelty_term", "label": "Novelty = distance from nearest retrieved known compound", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Docking & Composite Ranking"},
    {"id": "docs_architecture_evaluation_methodology", "label": "Evaluation Methodology", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Evaluation Methodology", "rationale": "Use the field's actual benchmarks, not ad hoc judgment: validity, uniqueness, novelty, internal diversity, MOSES/GuacaMol, retrieval precision, and a DUD-E docking sanity check."},
    {"id": "docs_architecture_dud_e_sanity_check", "label": "DUD-E Docking Sanity Check", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Evaluation Methodology", "rationale": "Where a benchmark target with known actives/decoys exists, confirm known actives score better than decoys as a sanity check on the docking setup."},
    {"id": "docs_architecture_dual_use_safety", "label": "Dual-Use Safety Design", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Responsible Use & Dual-Use Safety Design", "rationale": "De novo generation carries real acknowledged dual-use risk. A structural screening pass blocks known toxic-scaffold/controlled-substance analogs rather than merely flagging them; there is no supported path to condition generation toward maximizing toxicity. Load-bearing, not boilerplate."},
    {"id": "docs_architecture_observability", "label": "Observability and Langfuse Tracing", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\architecture.md", "source_location": "Observability"},
    {"id": "docs_requirements_docking_result_entity", "label": "DockingResult Core Data Entity", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\requirements.md", "source_location": "Core Data Entities", "rationale": "Per-candidate docking pose, affinity score, composite rank score and its formula version."},
    {"id": "docs_requirements_transparency", "label": "Transparent Scoring Requirement", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\requirements.md", "source_location": "Non-Functional Requirements", "rationale": "Every score shown to the user must be traceable to a disclosed formula or a named benchmark metric; no unexplained confidence:87% style outputs."},
    {"id": "docs_requirements_reproducibility", "label": "Reproducibility Requirement", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\requirements.md", "source_location": "Non-Functional Requirements", "rationale": "Generation runs record the model checkpoint version and random seed so a result can be regenerated."},
    {"id": "docs_requirements_safety_not_optional", "label": "Safety Pass Cannot Be Disabled", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\requirements.md", "source_location": "Non-Functional Requirements"},
    {"id": "docs_requirements_molecule_detail_view", "label": "Molecule Detail View with 3D Pose Viewer", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\requirements.md", "source_location": "UI Requirements", "rationale": "Full property breakdown, 3D docking pose viewer, Report Agent rationale, save/export actions."},
    {"id": "docs_requirements_async_by_design", "label": "Asynchronous by Design", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\requirements.md", "source_location": "Non-Functional Requirements", "rationale": "No request should block on a diffusion sampling run or a docking job."},
    {"id": "docs_techstack_autodock_vina", "label": "AutoDock Vina", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\tech-stack.md", "source_location": "Docking", "rationale": "Open-source, the default docking engine."},
    {"id": "docs_techstack_openbabel_mgltools", "label": "Open Babel / MGLTools Prep", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\tech-stack.md", "source_location": "Docking", "rationale": "For receptor/ligand file preparation: PDB -> PDBQT conversion, adding hydrogens, assigning charges."},
    {"id": "docs_techstack_diffdock", "label": "DiffDock (future alternate backend)", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\tech-stack.md", "source_location": "Docking", "rationale": "Optional alternate docking backend - the product's second legitimate use of diffusion models (pose prediction, not generation)."},
    {"id": "docs_techstack_graphdit_backbone", "label": "Graph-DiT via torch-molecule (V4 backbone)", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\tech-stack.md", "source_location": "Generative Model Layer", "rationale": "Chosen over EDM-3D because CPU sampling is feasible, MW/logP conditioning is native, and 2D fits both V5 conditioning paths. Chosen over the original DiGress repo because its published checkpoints are dead links."},
    {"id": "docs_techstack_3dmol_ncl_viewer", "label": "3Dmol.js / NGL Viewer", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\tech-stack.md", "source_location": "Frontend"},
    {"id": "docs_techstack_celery_redis_mandatory", "label": "Celery + Redis Mandatory", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\docs\\tech-stack.md", "source_location": "Backend", "rationale": "Unlike LexBook-AI where it was optional. Structure extraction, diffusion sampling, and docking are all slow; these must run as background jobs with status polling, not inline in a request/response cycle."},
    {"id": "claude_md_skill_routing", "label": "Tooling & Skill Routing", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\CLAUDE.md", "source_location": "Tooling & Skill Routing", "rationale": "Routing guidance only - the product workflow is unchanged by anything here. Read the relevant SKILL.md before starting work in its domain; do not guess at a skill's contents from its name."},
    {"id": "claude_md_elevator_pitch", "label": "Elevator Pitch and Honest Framing", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\CLAUDE.md", "source_location": "Elevator Pitch", "rationale": "Not a claim to discover real drugs - a faithful, benchmark-honest replication of the pattern real computational chemistry teams use, built as a real usable product rather than a research script."},
    {"id": "readme_current_status_v5", "label": "V5 Status (current HEAD)", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\README.md", "source_location": "Status", "rationale": "V5 conditions diffusion on retrieval via seed-graph init, with explicit fallback below 0.3 Tanimoto. Next: V6 Docking & Composite Ranking."},
    {"id": "readme_known_drugs_corpus", "label": "3,417 ChEMBL Approved Drugs Corpus", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\README.md", "source_location": "Knowledge Base (V1)", "rationale": "Chosen because approved drugs are a defensible, citable, target-agnostic retrieval baseline."},
    {"id": "readme_pdb_id_limitation", "label": "pdb_id Stored-String-Only Limitation", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\README.md", "source_location": "Project Intake & Retrieval (V2)", "rationale": "pdb_id is a stored reference string only - no structure fetch, no pocket handling. Full protein structure handling arrives with docking (V6). This is the exact gap V6 closes."},
    {"id": "readme_v5_measured_knob", "label": "V5 noise_steps Knob Proven but Bounded", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\README.md", "source_location": "Retrieval-Augmented Generation (V5)", "rationale": "The knob works (lower k moves outputs closer to the seed, 0.079 -> 0.128) without collapsing diversity, but absolute similarity stays low because QM9 caps at 9 heavy atoms. A ZINC-scale backbone would make the shift dramatic."},
    {"id": "readme_molecule_table_shared", "label": "MoleculeTable Shared Comparison Table", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\README.md", "source_location": "Property Filtering (V3)", "rationale": "Sortable/filterable, generic rows, reused unchanged by V4 and V5 - the V6 ranked table should extend the same component."},
    {"id": "prompts_v6_docking_ranking", "label": "V6 Build Prompt: Docking & Composite Ranking", "file_type": "rationale", "source_file": "D:\\Learning\\Molecule-Scout\\prompts\\v6-docking-ranking.md", "source_location": "Scope", "rationale": "Fetch and prepare the actual target structure (not just the stored PDB ID), dock as a Celery job, disclose formula + version in API and frontend, render 3D poses, and run a DUD-E sanity check if feasible. Ground rules: no LangGraph (V7), no Report Agent prose (V8), ask before adding a dependency not in tech-stack.md."},
    {"id": "prompts_v7_orchestration", "label": "V7 Build Prompt: Multi-Agent Orchestration", "file_type": "concept", "source_file": "D:\\Learning\\Molecule-Scout\\prompts\\v7-multi-agent-orchestration.md", "source_location": "Scope"},
